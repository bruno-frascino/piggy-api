# Database
DATABASE_URL="postgresql://username:password@localhost:5432/piggy_db"

# Server Configuration
PORT=4000
NODE_ENV=development
# Auto-apply pending Prisma migrations on server startup (development only)
DB_AUTO_MIGRATE=true

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Public frontend origin used to build links sent by email (password reset, etc.)
APP_URL="http://localhost:3000"

# Transactional email (Resend HTTPS API — DigitalOcean blocks outbound SMTP ports).
# Leave RESEND_API_KEY empty in development: emails are logged to the console instead.
RESEND_API_KEY=""
MAIL_FROM="Truffles <no-reply@trufflesinvestment.com.au>"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Symbol search is powered by Yahoo Finance public search endpoint (no API key required)

# Screener (market cap / dividend / sector-industry filters) is powered by Financial
# Modeling Prep — sign up at https://site.financialmodelingprep.com for a free-tier key
FMP_API_KEY=""
FMP_BASE_URL="https://financialmodelingprep.com/stable"
